{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🧠 Launch NeuroNetWorks Suite",
      "type": "shell",
      "command": "${workspaceFolder}/launch.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "🧪 Run Verification Self-Test",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["app.py", "--test"],
      "options": {
        "env": {
          "QT_QPA_PLATFORM": "offscreen",
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "🔄 Pretrain / Regenerate PyTorch Weights",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "core.trainer"],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "📦 Install / Update Dependencies (.venv)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pip",
      "args": ["install", "-r", "requirements.txt"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
